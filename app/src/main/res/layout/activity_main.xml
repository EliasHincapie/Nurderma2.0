<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BIENVENIDA ELIANA SOLETH"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnRegistrarPaciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Paciente" />

    <Button
        android:id="@+id/btnAsignarTratamiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asignar Tratamiento"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnVerTratamientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Tratamientos"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnVerAgenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Agenda"
        android:layout_marginTop="16dp" />
</LinearLayout>
