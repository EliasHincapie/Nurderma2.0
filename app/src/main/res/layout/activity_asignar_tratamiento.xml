<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asignar Tratamiento"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp" />

        <!-- Fecha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha:"
            android:textSize="14sp" />

        <DatePicker
            android:id="@+id/datePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleX="0.9"
            android:scaleY="0.9" />

        <!-- Hora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora:"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TimePicker
            android:id="@+id/timePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:scaleX="0.9"
            android:scaleY="0.9" />

        <!-- Selección de paciente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paciente:"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerPacientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Selección de tratamiento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tratamiento:"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerTratamientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Campo fecha texto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha (texto):"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editTextFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar fecha"
            android:focusable="false"
            android:clickable="true" />

        <!-- Campo hora texto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora (texto):"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editTextHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar hora"
            android:focusable="false"
            android:clickable="true" />

        <!-- Días de la semana -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Días de la semana:"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox android:id="@+id/checkLunes"  android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Lunes" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkMartes" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Martes" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkMiercoles" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Miércoles" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkJueves" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Jueves" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkViernes" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Viernes" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkSabado"  android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Sábado" android:textSize="13sp"/>
            <CheckBox android:id="@+id/checkDomingo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Domingo" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Botón -->
        <Button
            android:id="@+id/btnGuardarTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar Tratamiento"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
